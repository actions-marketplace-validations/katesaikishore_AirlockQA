{
  "name": "airlockqa",
  "version": "1.0.0",
  "description": "TypeScript browser testing tools with configurable request policies and signed run evidence",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "airlock": "./bin/airlock.js",
    "airlockqa": "./bin/airlock.js"
  },
  "files": [
    "bin/airlock.js",
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "bun test",
    "qa:gui": "bash scripts/gui-smoke.sh",
    "qa": "bun run build && bun test && bun run qa:gui",
    "cli": "bun ./bin/airlock.ts",
    "demo:server": "bun ./examples/demo-store/server.ts",
    "test:isolated": "bash scripts/test-isolated.sh"
  },
  "keywords": [
    "playwright",
    "browser-testing",
    "e2e-testing",
    "request-policy",
    "test-evidence",
    "merkle-tree",
    "typescript"
  ],
  "author": "AirlockQA Core Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "js-yaml": "^5.5.0",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.65.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "express": "^5.3.0",
    "typescript": "^7.0.2"
  }
}

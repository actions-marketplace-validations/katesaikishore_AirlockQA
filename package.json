{
  "name": "airlockqa",
  "version": "1.0.0",
  "description": "TypeScript browser testing tools with configurable request policies and signed run evidence",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "airlock": "./bin/airlock.js",
    "airlockqa": "./bin/airlock.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "qa:gui": "bash scripts/gui-smoke.sh",
    "qa": "bun run build && bun test && bun run qa:gui",
    "cli": "bun ./bin/airlock.ts",
    "demo:server": "bun ./examples/demo-store/server.ts"
  },
  "keywords": [
    "ai-qa",
    "playwright",
    "zero-trust",
    "phantom-credentials",
    "self-healing-tests",
    "time-travel-debugging",
    "merkle-tree",
    "compliance-soc2",
    "egress-firewall"
  ],
  "author": "AirlockQA Core Team",
  "license": "MIT",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "commander": "^15.0.0",
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}

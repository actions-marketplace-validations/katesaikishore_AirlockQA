{
  "projectName": "Acme SaaS Airlock QA",
  "baseUrl": "http://127.0.0.1:3900",
  "browser": {
    "headless": true,
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "proxy": {
    "enabled": true,
    "port": 8899
  },
  "secrets": {
    "STRIPE_SECRET_KEY": {
      "realFromEnv": "STRIPE_SECRET_KEY",
      "real": "REPLACE_ME_REAL_SECRET",
      "phantom": "ph_sec_stripe_test_8f2a1c",
      "allowedHosts": [
        "localhost",
        "127.0.0.1",
        "api.stripe.com"
      ],
      "allowedMethods": [
        "GET",
        "POST"
      ],
      "blockedPaths": [
        "*/refund*",
        "*/wipe*",
        "*/transfers*"
      ]
    },
    "ADMIN_AUTH_TOKEN": {
      "realFromEnv": "ADMIN_AUTH_TOKEN",
      "real": "REPLACE_ME_REAL_SECRET",
      "phantom": "ph_auth_bearer_9901_admin",
      "allowedHosts": [
        "localhost",
        "127.0.0.1"
      ],
      "blockedPaths": [
        "/api/admin/wipe-data"
      ]
    }
  },
  "policy": {
    "defaultAction": "BLOCK",
    "allowedEgressHosts": [
      "127.0.0.1",
      "localhost",
      "api.stripe.com"
    ],
    "blockedEgressHosts": [
      "pastebin.com",
      "webhook.site",
      "transfer.sh"
    ],
    "rules": [
      {
        "id": "block-destructive-refunds",
        "description": "Prevent accidental refunds or wipes during test runs",
        "hostPattern": "*",
        "blockedPaths": [
          "*/refund*",
          "*/wipe*",
          "*/delete-all*"
        ],
        "action": "BLOCK"
      },
      {
        "id": "allow-safe-charges",
        "description": "Allow test charge creation",
        "hostPattern": "api.stripe.com",
        "allowedPaths": [
          "/v1/charges",
          "/v1/customers"
        ],
        "action": "ALLOW"
      }
    ],
    "logPayloads": true
  },
  "compiler": {
    "outputDir": "./examples/tests",
    "defaultTimeoutMs": 10000,
    "emitAriaFallbacks": true
  },
  "healer": {
    "autoHeal": true,
    "confidenceThreshold": 0.8,
    "datasetDir": "./.airlock/dataset",
    "saveMutations": true
  },
  "forker": {
    "checkpointsDir": "./.airlock/checkpoints",
    "maxParallelForks": 5
  },
  "compliance": {
    "outputDir": "./.airlock/compliance",
    "generateHtmlReport": true
  },
  "workflow": {
    "name": "demo-store-checkout",
    "steps": [
      {
        "action": "goto",
        "url": "/"
      },
      {
        "action": "click",
        "selector": "[data-testid=\"login-btn\"]"
      },
      {
        "action": "expectVisible",
        "selector": "[data-testid=\"add-pro-plan\"]"
      },
      {
        "action": "checkpoint",
        "name": "post_auth"
      },
      {
        "action": "click",
        "selector": "[data-testid=\"add-pro-plan\"]"
      },
      {
        "action": "expectText",
        "selector": "[data-testid=\"cart-total\"]",
        "text": "$50.00"
      },
      {
        "action": "checkpoint",
        "name": "cart_ready"
      },
      {
        "action": "fill",
        "selector": "[data-testid=\"coupon-input\"]",
        "value": "AIRLOCK20"
      },
      {
        "action": "click",
        "selector": "[data-testid=\"apply-coupon-btn\"]"
      },
      {
        "action": "expectText",
        "selector": "[data-testid=\"cart-total\"]",
        "text": "$40.00"
      },
      {
        "action": "click",
        "selector": "[data-testid=\"checkout-btn\"]"
      },
      {
        "action": "expectText",
        "selector": "#checkout-status",
        "text": "charge created"
      },
      {
        "action": "request",
        "method": "POST",
        "url": "/api/admin/refund",
        "phantomSecret": "STRIPE_SECRET_KEY",
        "body": {
          "chargeId": "ch_12345",
          "amount": 5000
        },
        "expectStatus": 403
      }
    ]
  }
}
